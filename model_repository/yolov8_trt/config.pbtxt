name: "yolov8_trt"
platform: "tensorrt_plan"
max_batch_size: 4

dynamic_batching {
    max_queue_delay_microseconds: 500
}

input [
  {
    name: "input"
    data_type: TYPE_FP32
    dims: [3, 640, 640]
  }
]

output [
  {
    name: "output0"
    data_type: TYPE_FP16
    dims: [ 84, 8400 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_GPU
    gpus: [ 0 ]
  }
]